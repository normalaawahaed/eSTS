<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteAdminLTE.Master.cs" Inherits="eSTS.SiteAdminLTE" %>

<%@ Register Assembly="DevExpress.Web.v18.2, Version=18.2.7.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Namespace="DevExpress.Web" TagPrefix="dx" %>


<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="X-UA-Compatible" content="IE=edge; chrome=1; charset=UTF-8" />
    <title>eB</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
        name="viewport" />
    <link rel="stylesheet" href="assets/bower_components/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="assets/bower_components/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="assets/bower_components/Ionicons/css/ionicons.min.css" />
    <link rel="stylesheet" href="assets/dist/css/AdminLTE.min.css" />
    <link rel="stylesheet" href="assets/dist/css/skins/_all-skins.min.css" />
    <link href='http://fonts.googleapis.com/css?family=Fondamento' rel='stylesheet' type='text/css'>
    <link rel="stylesheet" href="css/style.css" type="text/css" />
    <link rel="stylesheet" type="text/css" href="assets/firework/css/fireworks.css" media="screen" />
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
    <!-- Google Font -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="hold-transition skin-blue sidebar-mini">

    <script type="text/javascript" src="<%= ResolveUrl("~/assets/bower_components/jquery/dist/jquery.min.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/bower_components/bootstrap/dist/js/bootstrap.min.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/bower_components/fastclick/lib/fastclick.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/dist/js/adminlte.min.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/dist/js/demo.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/bower_components/raphael/raphael.min.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/bower_components/morris.js/morris.min.js") %>"></script>
      <script type="text/javascript" src="<%= ResolveUrl("~/assets/firework/js/soundmanager2-nodebug-jsmin.js") %>"></script>
    <script type="text/javascript" src="<%= ResolveUrl("~/assets/firework/js/fireworks.js") %>"></script>
    <!-- jQuery Knob -->
    <script src="<%= ResolveUrl("~/assets/bower_components/jquery-knob/js/jquery.knob.js") %>"></script>
     
          
    <form id="form1" runat="server">
        <div class="wrapper">
            <div id="top">
                <header class="main-header">
                    <!-- Logo -->
                    <a href="#" class="logo">
                        <!-- mini logo for sidebar mini 50x50 pixels -->
                        <span class="logo-mini"><b>eB</b></span>
                        <!-- logo for regular state and mobile devices -->

                        <span class="logo-lg">
                            <img id="Img2" src="~/assets/logo2.png" runat="server" alt="" /><b>eSTS</span>

                    </a>
                    <!-- Header Navbar: style can be found in header.less -->
                    <nav class="navbar navbar-static-top">
                        <!-- Sidebar toggle button-->
                        <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                            <span class="sr-only">Toggle navigation</span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </a>
                        <div class="navbar-custom-menu">
                            <ul class="nav navbar-nav">
                                <!-- User Account: style can be found in dropdown.less -->
                                <li class="dropdown user user-menu">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                        
                                        <%--<img src="<%= ResolveUrl("~/assets/dist/img/avatar5.png") %>" class="user-image" alt="User Image" />--%>

                                        <span class="hidden-xs">
                                            <p>
                                                <dx:ASPxLabel ID="lblLoginName2" runat="server"></dx:ASPxLabel>
                                            </p>
                                        </span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <!-- User image -->
                                        <li class="user-header">

                                            <%--<img src="assets/dist/img/avatar5.png" class="img-circle" alt="User Image">--%>
                                            <%--<img src="<%= ResolveUrl("~/assets/dist/img/avatar5.png") %>" class="img-circle" alt="User Image" />--%>
                                          <%--  <img id="loginImgProfile2" src="" class="img-circle" alt="Image Not Found" runat="server" />--%>

                                            <%--<asp:Label ID="lblMasterFullName3" runat="server" Text="Label" Font-Size="Small"></asp:Label> - <asp:Label ID="lblMasterUnit" runat="server" Text="Label"></asp:Label>--%>
                                            <p>
                                                <dx:ASPxLabel ID="lblLoginName3" runat="server"></dx:ASPxLabel>
                                                <small>
                                                    <dx:ASPxLabel ID="lblMember" runat="server"></dx:ASPxLabel>
                                                </small>
                                                <%-- <small><dx:ASPxLabel ID="lblLastLogin" runat="server"></dx:ASPxLabel></small>
                              <small><dx:ASPxLabel ID="lblLastUpdate" runat="server"></dx:ASPxLabel></small>--%>
                                            </p>
                                        </li>
                                        <!-- Menu Body -->
                                        <li class="user-body">
                                            <div class="row">
                                                <div class="col-md-11">
                                                    <div class="progress-group">
                                                        <asp:Literal ID="lilProgress" runat="server"></asp:Literal>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.row -->
                                        </li>
                                        <!-- Menu Footer-->
                                        <li class="user-footer">
                                            <div class="pull-left">
                                                <a id="EditProfileLink" runat="server" href="~/StaffInfo/StaffInfo.aspx" class="btn bg-navy btn-flat"><i class="glyphicon glyphicon-user"></i>Profile</a>
                                            </div>
                                            <div class="pull-right">
                                                <a id="cmdLogOut" runat="server" href="#" class="btn bg-navy btn-flat"><i class="glyphicon glyphicon-log-out"></i>&nbsp; Sign out</a>
                                            </div>
                                        </li>
                                    </ul>
                                </li>
                                <!-- Control Sidebar Toggle Button -->
                                <li>
                                    <a href="#" data-toggle="control-sidebar"><i class="fa fa-gears"></i></a>
                                </li>
                            </ul>
                        </div>
                    </nav>
                </header>
            </div>
            <%-------------------------MENU------------------------%>
            <div id="lmenu">
                <!-- Left side column. contains the logo and sidebar -->
                <aside class="main-sidebar">
                    <!-- sidebar: style can be found in sidebar.less -->
                    <section class="sidebar">
                        <!-- Sidebar user panel -->
                        <div class="user-panel" style="height: 60px">
                            <div class="pull-left image">
                                <%--<img src="assets/dist/img/avatar5.png" class="img-circle" alt="User Image">--%>
                                 <img src="<%= ResolveUrl("~/assets/dist/img/avatar5.png") %>"class="img-circle" alt="User Image" />
                              <%--  <img id="loginImgProfile" src="" class="img-circle" alt="Image Not Found" runat="server" />--%>
                            </div>
                            <div class="pull-left info">
                                <p>
                                    <dx:ASPxLabel ID="lblLoginName" runat="server" Text="Welcome Mala!"></dx:ASPxLabel>

                                </p>
                                <%-- <i class="fa fa-id-badge text-info"></i> <asp:Label ID="lblMasterUnit2" runat="server" Text="Label"></asp:Label>--%>
                              <%--  <i class="fa fa-circle text-success"></i>Online</a>
                        --%>
                            </div>

                        </div>
                       
                       <%-- <div class="user-panel" style="height: 40px; padding-top: 0">
                            <div>
                                <div class="progress-group">
                                    <asp:Literal ID="lilProgress1" runat="server"></asp:Literal>
                                </div>
                            </div>
                        </div>--%>
                        <!-- sidebar menu: : style can be found in sidebar.less -->
                        <%--### MENU ###--%>
                        <asp:Literal ID="lilMenu" runat="server"></asp:Literal>
                        <%--### END MENU ###--%>
                    </section>
                    <!-- /.sidebar -->
                </aside>
            </div>

            <%----------------------CONTENT---------------------------%>

            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                <!-- Content Header (Page header) -->
                <section class="content-header">
                    <h1>
                        <asp:Label ID="lblPageTitle" runat="server" Text="&amp;nbsp;"></asp:Label>
                        <%--<small>Preview</small>--%>
                    </h1>
                    <asp:Literal ID="lilTitle" runat="server"></asp:Literal>

                    <%--    <ol class="breadcrumb">
                <li><a href="#"><i class="fa fa-dashboard"></i> Home</a><asp:Label ID="lblTitle1" runat="server" Text="Label"></asp:Label></li>
                <li><a href="#">Forms</a></li>
                <li class="active">General Elements</li>
                </ol>--%>
                </section>
                <!-- Main content -->
                <section class="content" style="padding: 2px">
                    <%--<div class="row">--%>
                    <!-- left column -->
                    <%--  <div class="col-md-12">--%>
                    <!-- general form elements -->
                    <%-- <div class="box box-widget">
                            <div class="box-header with-border">
                            </div>--%>
                    <!-- /.box-header -->
                    <!-- form start -->
                    <%--*****--%>
                    <asp:Label ID="lblMasterMsg" runat="server" ForeColor="Red" Text=""></asp:Label>

                    <%--  <div class="box-body">--%>
                    <%--<div class="form-group">--%>
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                    <%--</div>--%>
                    <%--  </div>--%>
                   
                    <%--*****--%>
                    <%--</div>--%>

                    <%-- </div>--%>
                    <!--/.col (left) -->
                    <%-- </div>--%>
                    <!-- /.row -->
                </section>
                <!-- /.content -->

            </div>
            <%-------------------------------------------------%>
            <!-- /.content-wrapper -->
            <footer class="main-footer">
                <div class="pull-right hidden-xs">
                    <b>Version</b> 1.1.0
                </div>
                <strong>Copyright &copy; 2019 <a href="http://www.lpj.gov.my">Lembaga Pelabuhan Johor</a>.</strong> All rights
            reserved.
            <div>
                Timeout session <%= Session.Timeout - 1 %> min.
            <asp:Label ID="lblTest" runat="server" Text="" Visible="true"></asp:Label>
                </div>
                <div>
                    <small>
                        <dx:ASPxLabel ID="lblLastUpdate" runat="server" Font-Names="'Source Sans Pro','Helvetica Neue',Helvetica,Arial,sans-serif" Font-Bold="true"></dx:ASPxLabel>
                    </small>
                </div>
            </footer>

        </div>
         <dx:ASPxHiddenField ID="hfHiddenField" ClientInstanceName="hfHiddenField" runat="server"></dx:ASPxHiddenField>
    </form>
     
    <!-- ./wrapper -->
    <%--------------------------------------------------------------------------------%>
</body>
</html>
